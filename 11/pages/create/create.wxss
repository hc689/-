.container {
  padding: 30rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 创作页面头部 */
.create-header {
  text-align: center;
  margin-bottom: 20rpx;
}

/* 顶部装饰 */
.create-banner {
  width: 100%;
  height: 200rpx;
  border-radius: 10rpx;
  overflow: hidden;
  margin-bottom: 30rpx;
  background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.banner-icon {
  font-size: 100rpx;
  opacity: 0.8;
  animation: pulse 2s ease-in-out infinite;
}

/* 已创作发布区域 */
.publish-section {
  background-color: white;
  padding: 30rpx;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
  animation: fadeIn 0.8s ease-in-out 0.2s both;
}

.publish-list {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.publish-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: linear-gradient(135deg, #f8f9fa, #ffffff);
  border-radius: 10rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
}

.publish-item:hover {
  transform: translateY(-5rpx);
  box-shadow: 0 5rpx 15rpx rgba(0, 0, 0, 0.1);
}

.publish-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
}

.publish-info {
  flex: 1;
}

.publish-title {
  font-size: 24rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 5rpx;
  display: block;
}

.publish-desc {
  font-size: 20rpx;
  color: #666;
  display: block;
}

.publish-btn {
  width: 120rpx;
  height: 60rpx;
  background-color: #ff6b6b;
  color: white;
  font-size: 24rpx;
  border-radius: 30rpx;
  line-height: 60rpx;
}

.publish-btn:hover {
  background-color: #ff5252;
}

.published-tag {
  width: 120rpx;
  height: 60rpx;
  background-color: #4caf50;
  color: white;
  font-size: 24rpx;
  border-radius: 30rpx;
  line-height: 60rpx;
  text-align: center;
}

/* 动画效果 */
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.create-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

.create-subtitle {
  font-size: 24rpx;
  color: #666;
  display: block;
}

/* 音乐风格选择 */
.style-section {
  background-color: white;
  padding: 30rpx;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  display: block;
}

.style-list {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.style-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
  background: linear-gradient(135deg, #f8f9fa, #ffffff);
  border-radius: 15rpx;
  margin-right: 10rpx;
  margin-bottom: 10rpx;
  width: 140rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
  cursor: pointer;
}

.style-item:hover {
  transform: translateY(-5rpx);
  box-shadow: 0 5rpx 15rpx rgba(0, 0, 0, 0.1);
}

.style-item.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  box-shadow: 0 5rpx 15rpx rgba(102, 126, 234, 0.4);
}

.style-item.active .style-name {
  color: white;
}

.style-icon {
  font-size: 48rpx;
  margin-bottom: 10rpx;
}

.style-name {
  font-size: 20rpx;
  text-align: center;
}

/* 创作参数设置 */
.params-section {
  background-color: white;
  padding: 30rpx;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
}

.param-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.param-item:last-child {
  border-bottom: none;
  margin-bottom: 0;
  padding-bottom: 0;
}

.param-label {
  font-size: 24rpx;
  color: #333;
}

.picker {
  font-size: 24rpx;
  color: #666;
  padding: 10rpx 20rpx;
  background-color: #f0f0f0;
  border-radius: 5rpx;
  min-width: 200rpx;
  text-align: center;
}

/* 歌词输入 */
.lyric-section {
  background-color: white;
  padding: 30rpx;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
}

.lyric-input {
  width: 100%;
  height: 200rpx;
  border: 1rpx solid #f0f0f0;
  border-radius: 5rpx;
  padding: 15rpx;
  font-size: 24rpx;
  resize: none;
}

/* 生成按钮 */
.generate-section {
  margin-bottom: 20rpx;
}

.generate-btn {
  width: 100%;
  height: 80rpx;
  background-color: #ff6b6b;
  color: white;
  font-size: 30rpx;
  border-radius: 40rpx;
  line-height: 80rpx;
}

/* 生成结果 */
.result-section {
  background-color: white;
  padding: 30rpx;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
}

.audio-player {
  margin-bottom: 20rpx;
}

.result-actions {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  height: 60rpx;
  background-color: #f0f0f0;
  color: #333;
  font-size: 24rpx;
  border-radius: 30rpx;
  line-height: 60rpx;
}