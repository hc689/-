.container {
  padding: 30rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 互动页面头部 */
.interact-header {
  text-align: center;
  margin-bottom: 20rpx;
}

/* 顶部装饰 */
.interact-banner {
  width: 100%;
  height: 200rpx;
  border-radius: 10rpx;
  overflow: hidden;
  margin-bottom: 30rpx;
  background: linear-gradient(135deg, #d299c2 0%, #fef9d7 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.banner-icon {
  font-size: 100rpx;
  opacity: 0.8;
  animation: pulse 2s ease-in-out infinite;
}

.interact-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

.interact-subtitle {
  font-size: 24rpx;
  color: #666;
  display: block;
}

/* 互动话题 */
.topic-section {
  background-color: white;
  padding: 30rpx;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  display: block;
}

.topic-list {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.topic-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background-color: #f0f0f0;
  border-radius: 10rpx;
}

.topic-icon {
  font-size: 40rpx;
  margin-right: 15rpx;
}

.topic-name {
  flex: 1;
  font-size: 24rpx;
  color: #333;
  font-weight: bold;
}

.topic-count {
  font-size: 20rpx;
  color: #666;
  margin-left: 15rpx;
}

/* 评论区 */
.comment-section {
  background-color: white;
  padding: 30rpx;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
}

.comment-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.comment-item {
  display: flex;
  gap: 15rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.comment-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.comment-avatar {
  font-size: 48rpx;
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
}

.comment-content {
  flex: 1;
}

.comment-username {
  font-size: 24rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 5rpx;
  display: block;
}

.comment-text {
  font-size: 22rpx;
  color: #666;
  margin-bottom: 10rpx;
  line-height: 1.4;
  display: block;
}

.comment-actions {
  display: flex;
  gap: 20rpx;
  font-size: 20rpx;
  color: #999;
}

.comment-time {
  margin-right: 20rpx;
}

.comment-action {
  cursor: pointer;
}

/* 发布评论 */
.post-section {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.post-input {
  flex: 1;
  height: 60rpx;
  border: 1rpx solid #f0f0f0;
  border-radius: 30rpx;
  padding: 0 20rpx;
  font-size: 24rpx;
  background-color: white;
}

.post-btn {
  width: 120rpx;
  height: 60rpx;
  background-color: #ff6b6b;
  color: white;
  font-size: 24rpx;
  border-radius: 30rpx;
  line-height: 60rpx;
}