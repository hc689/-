.container {
  padding: 30rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 作品信息 */
.work-header {
  display: flex;
  background-color: white;
  padding: 30rpx;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
}

.work-cover {
  width: 150rpx;
  height: 150rpx;
  border-radius: 5rpx;
  margin-right: 20rpx;
}

.work-info {
  flex: 1;
}

.work-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
  display: block;
}

.work-artist {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 10rpx;
  display: block;
}

.work-stats {
  font-size: 20rpx;
  color: #999;
  margin-bottom: 15rpx;
  display: block;
}

.work-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.work-tag {
  padding: 5rpx 15rpx;
  background-color: #f0f0f0;
  border-radius: 15rpx;
  font-size: 20rpx;
  color: #666;
}

/* 音频播放器 */
.player-section {
  background-color: white;
  padding: 30rpx;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
}

/* 歌词 */
.lyric-section {
  background-color: white;
  padding: 30rpx;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  display: block;
}

.lyric-content {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
  white-space: pre-wrap;
}

/* 作品介绍 */
.intro-section {
  background-color: white;
  padding: 30rpx;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
}

.intro-content {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

/* 评论区 */
.comment-section {
  background-color: white;
  padding: 30rpx;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
}

.comment-list {
  margin-bottom: 20rpx;
}

.comment-item {
  display: flex;
  gap: 15rpx;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.comment-item:last-child {
  border-bottom: none;
  margin-bottom: 0;
  padding-bottom: 0;
}

.comment-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
}

.comment-content {
  flex: 1;
}

.comment-username {
  font-size: 24rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 5rpx;
  display: block;
}

.comment-text {
  font-size: 22rpx;
  color: #666;
  margin-bottom: 10rpx;
  line-height: 1.4;
  display: block;
}

.comment-time {
  font-size: 20rpx;
  color: #999;
  display: block;
}

.comment-input-section {
  display: flex;
  gap: 20rpx;
}

.comment-input {
  flex: 1;
  height: 60rpx;
  border: 1rpx solid #f0f0f0;
  border-radius: 30rpx;
  padding: 0 20rpx;
  font-size: 24rpx;
  background-color: #f9f9f9;
}

.comment-btn {
  width: 120rpx;
  height: 60rpx;
  background-color: #ff6b6b;
  color: white;
  font-size: 24rpx;
  border-radius: 30rpx;
  line-height: 60rpx;
}

/* 操作按钮 */
.action-section {
  display: flex;
  justify-content: space-around;
  background-color: white;
  padding: 30rpx;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  background-color: transparent;
  border: none;
  padding: 0;
}

.action-icon {
  font-size: 32rpx;
  margin-bottom: 5rpx;
}

.action-text {
  font-size: 20rpx;
  color: #333;
}