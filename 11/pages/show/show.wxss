.container {
  padding: 30rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 展示页面头部 */
.show-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.show-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

.show-subtitle {
  font-size: 24rpx;
  color: #666;
  display: block;
}

/* 搜索栏 */
.search-section {
  display: flex;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.search-input {
  flex: 1;
  height: 60rpx;
  border: 1rpx solid #f0f0f0;
  border-radius: 30rpx;
  padding: 0 20rpx;
  font-size: 24rpx;
  background-color: white;
}

.search-btn {
  width: 120rpx;
  height: 60rpx;
  background-color: #ff6b6b;
  color: white;
  font-size: 24rpx;
  border-radius: 30rpx;
  line-height: 60rpx;
}

/* 分类标签 */
.category-section {
  margin-bottom: 30rpx;
}

.category-scroll {
  white-space: nowrap;
}

.category-item {
  display: inline-block;
  padding: 10rpx 20rpx;
  margin-right: 20rpx;
  background-color: white;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #333;
}

.category-item.active {
  background-color: #ff6b6b;
  color: white;
}

/* 作品列表 */
.works-section {
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  display: block;
}

.works-list {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.work-item {
  background-color: white;
  border-radius: 10rpx;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.work-cover {
  font-size: 80rpx;
  text-align: center;
  margin-bottom: 15rpx;
  padding: 60rpx 0;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 10rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.15);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.work-cover::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: linear-gradient(45deg, transparent, rgba(255, 255, 255, 0.2), transparent);
  transform: rotate(45deg);
  animation: shine 3s infinite;
}

.work-cover:hover {
  transform: translateY(-5rpx);
  box-shadow: 0 12rpx 25rpx rgba(0, 0, 0, 0.2);
}

/* 动画效果 */
@keyframes shine {
  0% {
    transform: translateX(-100%) rotate(45deg);
  }
  100% {
    transform: translateX(100%) rotate(45deg);
  }
}

.work-info {
  width: 100%;
}

.work-title {
  font-size: 24rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 5rpx;
  display: block;
}

.work-artist {
  font-size: 20rpx;
  color: #666;
  margin-bottom: 10rpx;
  display: block;
}

.work-stats {
  display: flex;
  justify-content: space-between;
  font-size: 18rpx;
  color: #999;
  margin-bottom: 15rpx;
}

.work-audio {
  width: 100%;
  height: 80rpx;
  margin-top: 10rpx;
}

/* 传统民歌 */
.traditional-section {
  margin-bottom: 30rpx;
}